---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import { REPO, SITE, markdownPath } from '../lib/markdown';
import { latestRelease } from '../lib/release';
import { AUTHOR, OG_IMAGE, OG_IMAGE_ALT, absolute, schemaGraph, serialize } from '../lib/seo';
import type { Crumb, PageType } from '../lib/seo';

interface Props {
  title: string;
  description: string;
  /** `article` for docs and decisions, `website` for everything else. */
  type?: PageType;
  /** Index pages: the WebPage node becomes a CollectionPage. */
  collection?: boolean;
  /** The breadcrumb shown on the page, without the home crumb. */
  crumbs?: Crumb[];
  /** Extra schema.org nodes merged into the page's graph. */
  schema?: Record<string, unknown>[];
  datePublished?: string;
  dateModified?: string;
  /** Site-relative or absolute path of the social image. */
  image?: string;
  noindex?: boolean;
}

const {
  title,
  description,
  type = 'website',
  collection = false,
  crumbs = [],
  schema = [],
  datePublished,
  dateModified,
  image = '/og.png',
  noindex = false,
} = Astro.props;
const pathname = Astro.url.pathname;
const canonical = absolute(pathname);
const markdown = new URL(markdownPath(pathname), SITE);
const fullTitle = pathname === '/' ? title : `${title} - Coding Owl`;
const ogImage = image === '/og.png' ? OG_IMAGE : absolute(image);
const robots = noindex ? 'noindex, nofollow' : 'index, follow';
const graph = schemaGraph({
  canonical,
  title: fullTitle,
  description,
  image: ogImage,
  type,
  collection,
  crumbs,
  datePublished,
  dateModified,
  extra: schema,
});
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={AUTHOR} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="text/markdown" href={markdown} title="Markdown" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600&family=Geist+Mono:wght@400;500&display=swap"
    />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="Coding Owl" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={OG_IMAGE_ALT} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={OG_IMAGE_ALT} />
    <meta name="theme-color" content="#fafafa" />
    <meta name="generator" content={Astro.generator} />
    <script type="application/ld+json" set:html={serialize(graph)} />
  </head>
  <body class="flex min-h-screen flex-col">
    <Nav />
    <main class="mx-auto w-full max-w-5xl flex-1 px-6 pb-24 sm:px-10">
      <slot />
    </main>
    <footer class="mx-auto w-full max-w-5xl px-6 pb-12 sm:px-10">
      <div class="flex flex-wrap items-center gap-x-8 gap-y-2 border-t border-line pt-8 text-sm text-ink-faint">
        <span>Coding Owl</span>
        <span>
          Latest release:{' '}
          <a href="/changelog" class="font-mono no-underline hover:text-ink">{latestRelease ?? 'unreleased'}</a>
        </span>
        <a href="/docs" class="no-underline hover:text-ink">Docs</a>
        <a href="/changelog" class="no-underline hover:text-ink">Changelog</a>
        <a href={REPO} class="no-underline hover:text-ink" rel="noopener">GitHub</a>
        <a href={markdown.pathname} class="ml-auto no-underline hover:text-ink" title="This page as Markdown">
          This page as Markdown
        </a>
      </div>
    </footer>
  </body>
</html>
