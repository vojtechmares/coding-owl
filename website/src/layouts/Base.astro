---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import { REPO, SITE, markdownPath } from '../lib/markdown';

interface Props {
  title: string;
  description: string;
  /** Wider than the reading column, for the homepage. */
  wide?: boolean;
}

const { title, description, wide = false } = Astro.props;
const pathname = Astro.url.pathname;
const canonical = new URL(pathname === '/' ? '/' : pathname.replace(/\/+$/, ''), SITE);
const markdown = new URL(markdownPath(pathname), SITE);
const fullTitle = pathname === '/' ? title : `${title} - Coding Owl`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="text/markdown" href={markdown} title="Markdown" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Coding Owl" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="theme-color" content="#0a0f22" />
    <meta name="generator" content={Astro.generator} />
  </head>
  <body class="flex min-h-screen flex-col pt-4">
    <Nav />
    <main class:list={['mx-auto w-full flex-1 px-4 pt-10 pb-16', wide ? 'max-w-3xl' : 'max-w-3xl']}>
      <slot />
    </main>
    <footer class="mx-auto w-full max-w-3xl px-4 pb-10 text-sm text-ink-faint">
      <div class="flex flex-wrap items-center gap-x-5 gap-y-2 border-t border-glass-edge pt-6">
        <span>Coding Owl</span>
        <a href="/docs" class="no-underline hover:text-ink-dim">Docs</a>
        <a href="/changelog" class="no-underline hover:text-ink-dim">Changelog</a>
        <a href={REPO} class="no-underline hover:text-ink-dim" rel="noopener">GitHub</a>
        <a href={markdown.pathname} class="ml-auto no-underline hover:text-ink-dim" title="This page as Markdown">
          Markdown
        </a>
      </div>
    </footer>
  </body>
</html>
