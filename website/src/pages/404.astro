---
import Base from '../layouts/Base.astro';
---

<Base title="Not found" description="There is no page at this address.">
  <section class="glass px-6 py-10 text-center sm:px-10">
    <p class="font-mono text-sm text-ink-faint">404</p>
    <h1 class="mt-2 text-3xl font-semibold tracking-tight text-ink">Nothing here</h1>
    <p class="mt-3 text-ink-dim">There is no page at this address.</p>
    <a
      href="/"
      class="mt-6 inline-block rounded-(--radius-control) border border-glass-edge-strong bg-glass px-4 py-2 text-sm font-medium text-ink no-underline hover:bg-glass-strong"
    >
      Back to the start
    </a>
  </section>
</Base>
