---
import Base from '../layouts/Base.astro';
---

<Base title="Not found" description="There is no page at this address." noindex>
  <section class="mx-auto max-w-md pt-28 pb-20 text-center">
    <p class="eyebrow">404</p>
    <h1 class="mt-4 text-4xl font-semibold tracking-tight text-ink">Nothing here.</h1>
    <p class="mt-4 text-ink-dim">There is no page at this address.</p>
    <a href="/" class="btn btn-primary mt-8">Back to the start</a>
  </section>
</Base>
