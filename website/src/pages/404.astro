---
import Base from '../layouts/Base.astro';
---

<Base title="Not found" description="There is no page at this address.">
  <section class="panel mx-auto max-w-md px-6 py-10 text-center">
    <p class="label">404</p>
    <h1 class="mt-2 text-3xl font-semibold tracking-tight text-ink">Nothing here</h1>
    <p class="mt-3 text-ink-dim">There is no page at this address.</p>
    <a
      href="/"
      class="mt-6 inline-block rounded-(--radius-control) bg-accent px-3.5 py-2 text-sm font-medium text-ink-on-accent no-underline hover:bg-accent-strong"
    >
      Back to the start
    </a>
  </section>
</Base>
