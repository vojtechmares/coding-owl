---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const docs = (await getCollection('docs')).sort((a, b) => a.data.order - b.data.order);
const decisions = await getCollection('decisions');
const latest = decisions.map((d) => d.data.number).reduce((a, b) => Math.max(a, b), 0);

const cards = [
  ...docs.map((d) => ({
    href: `/docs/${d.id}`,
    title: d.data.title,
    description: d.data.description,
    source: d.data.source,
  })),
  {
    href: '/docs/decisions',
    title: 'Decisions',
    description: `${decisions.length} architecture decision records, up to ADR-${String(latest).padStart(4, '0')}. Why Owl is built the way it is.`,
    source: 'docs/adr/',
  },
];
---

<Base title="Documentation" description="How to install Coding Owl, the words it uses, and the decisions behind it.">
  <p class="label">docs</p>
  <h1 class="mt-2 text-3xl font-semibold tracking-tight text-ink">Documentation</h1>
  <p class="mt-3 max-w-xl text-ink-dim">
    Everything here is read from the repository at build time, so the site says what the code says.
  </p>
  <ul class="mt-8 grid gap-3 sm:grid-cols-3">
    {
      cards.map((card) => (
        <li>
          <a href={card.href} class="panel flex h-full flex-col px-4 py-4 no-underline transition-colors hover:border-line-strong">
            <h2 class="text-base font-semibold text-ink">{card.title}</h2>
            <p class="mt-1.5 flex-1 text-sm leading-6 text-ink-dim">{card.description}</p>
            <p class="mt-4 font-mono text-[11px] text-ink-faint">{card.source}</p>
          </a>
        </li>
      ))
    }
  </ul>
</Base>
