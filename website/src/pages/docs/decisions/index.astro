---
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import PageHead from '../../../components/PageHead.astro';

const decisions = (await getCollection('decisions')).sort((a, b) => b.data.number - a.data.number);
const pad = (n: number) => String(n).padStart(4, '0');
const statusClass = (status: string) =>
  status.startsWith('Accepted') ? 'text-added' : status.startsWith('Superseded') ? 'text-ink-faint' : 'text-changed';
const shortStatus = (status: string) => status.split(/[;,]/)[0].trim();
const crumbs = [{ href: '/docs', label: 'Docs' }, { label: 'Decisions' }];
---

<Base
  title="Architecture decision records"
  description="One record per decision, numbered in the order they were accepted. Why Coding Owl is built the way it is."
  collection
  crumbs={crumbs}
>
  <PageHead
    crumbs={crumbs}
    title="Architecture decision records."
    lead="One record per decision, numbered in the order decisions were accepted. Numbers are never reused and records are never deleted; a decision that stops being true is marked superseded and stays where it is."
  />
  <div class="hidden grid-cols-[4rem_1fr_7rem_8rem] gap-x-8 border-b border-line pb-3 sm:grid">
    <span class="eyebrow">ADR</span>
    <span class="eyebrow">Title</span>
    <span class="eyebrow">Date</span>
    <span class="eyebrow">Status</span>
  </div>
  <ol class="divide-y divide-line border-t border-line sm:border-t-0">
    {
      decisions.map((d) => (
        <li>
          <a
            href={`/docs/decisions/${d.id}`}
            class="group grid gap-x-8 gap-y-1 py-4 no-underline sm:grid-cols-[4rem_1fr_7rem_8rem] sm:items-baseline"
          >
            <span class="font-mono text-xs text-ink-faint">{pad(d.data.number)}</span>
            <span class="text-[15px] text-ink group-hover:text-accent">{d.data.title}</span>
            <span class="text-sm text-ink-faint">{d.data.date}</span>
            <span class:list={['inline-flex items-center gap-2 text-sm', statusClass(d.data.status)]} title={d.data.status}>
              <span class="dot" aria-hidden="true" />
              {shortStatus(d.data.status)}
            </span>
          </a>
        </li>
      ))
    }
  </ol>
</Base>
