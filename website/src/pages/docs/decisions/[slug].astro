---
import { getCollection, render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import { REPO } from '../../../lib/markdown';

export async function getStaticPaths() {
  const decisions = (await getCollection('decisions')).sort((a, b) => a.data.number - b.data.number);
  return decisions.map((d, i) => ({
    params: { slug: d.id },
    props: { d, prev: decisions[i - 1], next: decisions[i + 1] },
  }));
}

const { d, prev, next } = Astro.props;
const { Content } = await render(d);
const pad = (n: number) => String(n).padStart(4, '0');
const num = pad(d.data.number);
const meta: [string, string][] = [
  ['Status', d.data.status],
  ['Date', d.data.date],
];
if (d.data.supersedes) meta.push(['Supersedes', d.data.supersedes]);
if (d.data.amended) meta.push(['Amended', d.data.amended]);
---

<Base title={`ADR-${num}: ${d.data.title}`} description={`Architecture decision record ${num}: ${d.data.title}.`}>
  <nav class="text-sm text-ink-faint" aria-label="Breadcrumb">
    <a href="/docs" class="no-underline hover:text-ink-dim">Docs</a>
    <span class="mx-1.5" aria-hidden="true">/</span>
    <a href="/docs/decisions" class="no-underline hover:text-ink-dim">Decisions</a>
    <span class="mx-1.5" aria-hidden="true">/</span>
    <span class="text-ink-dim">ADR-{num}</span>
  </nav>
  <p class="mt-3 font-mono text-sm text-ink-faint">ADR-{num}</p>
  <h1 class="mt-1 text-3xl font-semibold tracking-tight text-ink">{d.data.title}</h1>
  <dl class="mt-5 grid gap-x-6 gap-y-2 text-sm sm:grid-cols-[auto_1fr]">
    {
      meta.map(([k, v]) => (
        <>
          <dt class="text-ink-faint">{k}</dt>
          <dd class="text-ink-dim">{v}</dd>
        </>
      ))
    }
  </dl>
  <article class="glass prose mt-8 px-6 py-8 sm:px-8">
    <Content />
  </article>
  <p class="mt-6 text-sm text-ink-faint">
    Source: <a href={`${REPO}/blob/main/${d.data.source}`} class="hover:text-ink-dim" rel="noopener">{d.data.source}</a>
  </p>
  <nav class="mt-8 flex justify-between gap-4 text-sm" aria-label="Neighbouring decisions">
    {
      prev ? (
        <a href={`/docs/decisions/${prev.id}`} class="glass max-w-[48%] px-4 py-3 no-underline hover:bg-glass-strong">
          <span class="block text-xs text-ink-faint">Previous</span>
          <span class="text-ink-dim">
            ADR-{pad(prev.data.number)}: {prev.data.title}
          </span>
        </a>
      ) : (
        <span />
      )
    }
    {
      next && (
        <a
          href={`/docs/decisions/${next.id}`}
          class="glass max-w-[48%] px-4 py-3 text-right no-underline hover:bg-glass-strong"
        >
          <span class="block text-xs text-ink-faint">Next</span>
          <span class="text-ink-dim">
            ADR-{pad(next.data.number)}: {next.data.title}
          </span>
        </a>
      )
    }
  </nav>
</Base>
