---
import { getCollection, render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import PageHead from '../../../components/PageHead.astro';
import { REPO } from '../../../lib/markdown';

export async function getStaticPaths() {
  const decisions = (await getCollection('decisions')).sort((a, b) => a.data.number - b.data.number);
  return decisions.map((d, i) => ({
    params: { slug: d.id },
    props: { d, prev: decisions[i - 1], next: decisions[i + 1] },
  }));
}

const { d, prev, next } = Astro.props;
const { Content } = await render(d);
const pad = (n: number) => String(n).padStart(4, '0');
const num = pad(d.data.number);
const meta: [string, string][] = [
  ['Status', d.data.status],
  ['Date', d.data.date],
];
if (d.data.supersedes) meta.push(['Supersedes', d.data.supersedes]);
if (d.data.amended) meta.push(['Amended', d.data.amended]);
---

<Base title={`ADR-${num}: ${d.data.title}`} description={`Architecture decision record ${num}: ${d.data.title}.`}>
  <PageHead
    crumbs={[{ href: '/docs', label: 'Docs' }, { href: '/docs/decisions', label: 'Decisions' }, { label: `ADR-${num}` }]}
    eyebrow={`ADR-${num}`}
    title={d.data.title}
  />
  <div class="grid gap-12 border-t border-line pt-12 lg:grid-cols-[1fr_14rem] lg:gap-20">
    <article class="prose order-2 lg:order-1">
      <Content />
    </article>
    <aside class="order-1 lg:order-2 lg:sticky lg:top-10 lg:self-start">
      <dl class="divide-y divide-line text-sm">
        {
          meta.map(([k, v]) => (
            <div class="py-3 first:pt-0">
              <dt class="eyebrow">{k}</dt>
              <dd class="mt-1.5 text-ink-dim">{v}</dd>
            </div>
          ))
        }
        <div class="py-3">
          <dt class="eyebrow">Source</dt>
          <dd class="mt-1.5 break-all text-ink-dim">
            <a href={`${REPO}/blob/main/${d.data.source}`} class="hover:text-ink" rel="noopener">{d.data.source}</a>
          </dd>
        </div>
      </dl>
    </aside>
  </div>
  <nav class="mt-20 grid gap-8 border-t border-line pt-8 sm:grid-cols-2" aria-label="Neighbouring decisions">
    {
      prev ? (
        <a href={`/docs/decisions/${prev.id}`} class="group no-underline">
          <span class="eyebrow">← Previous</span>
          <span class="mt-2 block text-[15px] text-ink group-hover:text-accent">
            <span class="font-mono text-xs text-ink-faint">{pad(prev.data.number)}</span> {prev.data.title}
          </span>
        </a>
      ) : (
        <span />
      )
    }
    {
      next && (
        <a href={`/docs/decisions/${next.id}`} class="group text-right no-underline">
          <span class="eyebrow">Next →</span>
          <span class="mt-2 block text-[15px] text-ink group-hover:text-accent">
            <span class="font-mono text-xs text-ink-faint">{pad(next.data.number)}</span> {next.data.title}
          </span>
        </a>
      )
    }
  </nav>
</Base>
