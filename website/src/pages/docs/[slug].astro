---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { REPO } from '../../lib/markdown';

export async function getStaticPaths() {
  const docs = await getCollection('docs');
  return docs.map((doc) => ({ params: { slug: doc.id }, props: { doc } }));
}

const { doc } = Astro.props;
const { Content } = await render(doc);
---

<Base title={doc.data.title} description={doc.data.description}>
  <nav class="text-sm text-ink-faint" aria-label="Breadcrumb">
    <a href="/docs" class="no-underline hover:text-ink-dim">Docs</a>
    <span class="mx-1.5" aria-hidden="true">/</span>
    <span class="text-ink-dim">{doc.data.title}</span>
  </nav>
  <h1 class="mt-3 text-3xl font-semibold tracking-tight text-ink">{doc.data.title}</h1>
  <p class="mt-2 text-ink-dim">{doc.data.description}</p>
  <article class="glass prose mt-8 px-6 py-8 sm:px-8">
    <Content />
  </article>
  <p class="mt-6 text-sm text-ink-faint">
    Source: <a href={`${REPO}/blob/main/${doc.data.source}`} class="hover:text-ink-dim" rel="noopener"
      >{doc.data.source}</a
    >
  </p>
</Base>
