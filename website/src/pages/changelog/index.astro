---
import { marked } from 'marked';
import Base from '../../layouts/Base.astro';
import ChangeBadge from '../../components/ChangeBadge.astro';
import { changelog } from '../../lib/changelog';
import { REPO } from '../../lib/markdown';

const inline = (md: string) => marked.parseInline(md, { async: false }) as string;
const block = (md: string) => marked.parse(md, { async: false }) as string;
const anchor = (version: string) => version.toLowerCase().replace(/[^a-z0-9.]+/g, '-');
---

<Base title="Changelog" description="Every notable change to Coding Owl, release by release.">
  <p class="label">changelog</p>
  <h1 class="mt-2 text-3xl font-semibold tracking-tight text-ink">{changelog.title}</h1>
  {changelog.intro && <div class="prose mt-3 text-[15px]" set:html={block(changelog.intro)} />}

  <ol class="mt-10 space-y-6">
    {
      changelog.releases.map((release) => (
        <li id={anchor(release.version)} class="panel scroll-mt-20 overflow-hidden">
          <header class="flex flex-wrap items-baseline gap-x-4 gap-y-1 border-b border-line bg-neutral-50 px-5 py-3">
            <h2 class="font-mono text-base font-medium text-ink">
              {release.url ? (
                <a href={release.url} class="no-underline hover:text-accent" rel="noopener">
                  {release.version}
                </a>
              ) : (
                release.version
              )}
            </h2>
            {release.date && (
              <time datetime={release.date} class="font-mono text-xs text-ink-faint">
                {release.date}
              </time>
            )}
            {release.yanked && <ChangeBadge type="Yanked" />}
            <a href={`#${anchor(release.version)}`} class="ml-auto font-mono text-xs text-ink-faint no-underline hover:text-ink">
              #
            </a>
          </header>
          <div class="px-5 py-4">
            {release.notes && <div class="prose text-[15px]" set:html={block(release.notes)} />}
            {release.sections.map((section, i) => (
              <section class:list={[i > 0 || release.notes ? 'mt-5' : '']}>
                <h3 class="sr-only">{section.type}</h3>
                <ChangeBadge type={section.type} />
                <ul class="prose mt-2 list-disc pl-5 text-[15px] marker:text-ink-faint">
                  {section.items.map((item) => (
                    <li set:html={inline(item)} />
                  ))}
                </ul>
              </section>
            ))}
            {release.sections.length === 0 && !release.notes && (
              <p class="text-sm text-ink-faint">Nothing recorded yet.</p>
            )}
          </div>
        </li>
      ))
    }
  </ol>

  <p class="mt-8 font-mono text-xs text-ink-faint">
    kept in <a href={`${REPO}/blob/main/CHANGELOG.md`} class="hover:text-ink" rel="noopener">CHANGELOG.md</a>, in the
    <a href="https://keepachangelog.com/en/1.1.0/" class="hover:text-ink" rel="noopener">keep a changelog</a> format
  </p>
</Base>
