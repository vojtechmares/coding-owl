---
import { marked } from 'marked';
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import ChangeBadge from '../../components/ChangeBadge.astro';
import { changelog } from '../../lib/changelog';
import { REPO } from '../../lib/markdown';

const inline = (md: string) => marked.parseInline(md, { async: false }) as string;
const block = (md: string) => marked.parse(md, { async: false }) as string;
const anchor = (version: string) => version.toLowerCase().replace(/[^a-z0-9.]+/g, '-');
---

<Base title="Changelog" description="Every notable change to Coding Owl, release by release.">
  <PageHead eyebrow="Changelog" title="What changed, release by release.">
    {changelog.intro && <div class="prose mt-5 max-w-xl text-[15px]" set:html={block(changelog.intro)} />}
  </PageHead>

  <ol class="divide-y divide-line border-t border-line">
    {
      changelog.releases.map((release) => (
        <li id={anchor(release.version)} class="grid scroll-mt-10 gap-8 py-12 lg:grid-cols-[14rem_1fr]">
          <header class="lg:sticky lg:top-10 lg:self-start">
            <h2 class="text-2xl font-semibold tracking-tight text-ink">
              {release.url ? (
                <a href={release.url} class="no-underline hover:text-accent" rel="noopener">
                  {release.version}
                </a>
              ) : (
                release.version
              )}
            </h2>
            {release.date && (
              <time datetime={release.date} class="mt-1 block text-sm text-ink-faint">
                {release.date}
              </time>
            )}
            {release.yanked && (
              <div class="mt-3">
                <ChangeBadge type="Yanked" />
              </div>
            )}
            <a href={`#${anchor(release.version)}`} class="mt-3 block text-sm text-ink-faint no-underline hover:text-ink">
              Link to this release
            </a>
          </header>
          <div>
            {release.notes && <div class="prose text-[15px]" set:html={block(release.notes)} />}
            {release.sections.map((section, i) => (
              <section class:list={[i > 0 || release.notes ? 'mt-8' : '']}>
                <h3 class="sr-only">{section.type}</h3>
                <ChangeBadge type={section.type} />
                <ul class="mt-3 divide-y divide-line">
                  {section.items.map((item) => (
                    <li class="prose py-3 text-[15px] leading-7" set:html={inline(item)} />
                  ))}
                </ul>
              </section>
            ))}
            {release.sections.length === 0 && !release.notes && (
              <p class="text-sm text-ink-faint">Nothing recorded yet.</p>
            )}
          </div>
        </li>
      ))
    }
  </ol>

  <p class="mt-12 text-sm text-ink-faint">
    Kept in <a href={`${REPO}/blob/main/CHANGELOG.md`} class="hover:text-ink" rel="noopener">CHANGELOG.md</a>, in the
    <a href="https://keepachangelog.com/en/1.1.0/" class="hover:text-ink" rel="noopener">Keep a Changelog</a> format.
  </p>
</Base>
