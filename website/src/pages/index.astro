---
import { getEntry, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Mark from '../components/Mark.astro';
import CopyCommand from '../components/CopyCommand';
import Terminal from '../components/Terminal';
import { REPO } from '../lib/markdown';
import overview from '../../../docs/desktop/overview.jpg';

const page = await getEntry('pages', 'home');
if (!page) throw new Error('src/content/pages/home.md is missing');
const { Content } = await render(page);
const { title, tagline, description, install } = page.data;
---

<Base title={title} description={description}>
  <section class="grid items-start gap-10 lg:grid-cols-[1.05fr_1fr] lg:gap-12">
    <div class="min-w-0">
      <div class="flex items-center gap-3">
        <Mark size={40} />
        <p class="label flex items-center gap-2">
          <span class="dot text-accent" aria-hidden="true"></span>
          macOS · daemon + desktop app
        </p>
      </div>
      <h1 class="mt-6 text-4xl font-semibold tracking-tight text-ink sm:text-[2.75rem] sm:leading-[1.1]">
        {tagline}
      </h1>
      <p class="mt-5 max-w-lg text-lg leading-8 text-ink-dim">{description}</p>
      <div class="mt-7 max-w-lg">
        <CopyCommand client:load command={install} />
      </div>
      <div class="mt-4 flex flex-wrap gap-2 text-sm">
        <a
          href="/docs/guide#installing"
          class="rounded-(--radius-control) bg-accent px-3.5 py-2 font-medium text-ink-on-accent no-underline transition-colors hover:bg-accent-strong"
        >
          Get started
        </a>
        <a
          href="/docs"
          class="panel px-3.5 py-2 font-medium text-ink no-underline transition-colors hover:border-line-strong"
        >
          Read the docs
        </a>
        <a
          href={REPO}
          rel="noopener"
          class="px-3.5 py-2 font-mono text-[13px] text-ink-dim no-underline transition-colors hover:text-ink"
        >
          github →
        </a>
      </div>
    </div>
    <div class="min-w-0">
      <Terminal client:load />
    </div>
  </section>

  <section class="mt-16">
    <p class="label mb-3">the desktop app</p>
    <figure class="panel overflow-hidden p-1.5">
      <Image
        src={overview}
        alt="The Coding Owl desktop app: the overview with jobs pending, one awaiting review and one blocked."
        widths={[640, 960, 1400]}
        sizes="(min-width: 896px) 864px, 100vw"
        class="w-full rounded-[3px]"
        loading="lazy"
      />
    </figure>
  </section>

  <article class="prose mt-16">
    <Content />
  </article>
</Base>
