---
import { getEntry, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Mark from '../components/Mark.astro';
import CopyCommand from '../components/CopyCommand';
import Terminal from '../components/Terminal';
import SectionHead from '../components/SectionHead.astro';
import { REPO } from '../lib/markdown';
import overview from '../../../docs/desktop/overview.jpg';

const page = await getEntry('pages', 'home');
if (!page) throw new Error('src/content/pages/home.md is missing');
const { Content } = await render(page);
const { title, eyebrow, tagline, description, install, features } = page.data;
---

<Base title={title} description={description}>
  <section class="relative pt-20 pb-24 text-center sm:pt-28 sm:pb-28">
    <div class="grid-backdrop -mx-6 sm:-mx-10" aria-hidden="true"></div>
    <div class="flex justify-center">
      <Mark size={64} />
    </div>
    <p class="eyebrow mt-8">{eyebrow}</p>
    <h1 class="mx-auto mt-6 max-w-3xl text-5xl font-semibold tracking-tight text-ink sm:text-6xl sm:leading-[1.05]">
      {tagline}
    </h1>
    <p class="mx-auto mt-7 max-w-xl text-lg leading-8 text-ink-dim">{description}</p>
    <div class="mt-9 flex flex-wrap justify-center gap-3">
      <a href="/docs/guide#installing" class="btn btn-primary">Get started</a>
      <a href="/docs" class="btn btn-secondary">Read the docs</a>
    </div>
    <div class="mx-auto mt-8 max-w-md">
      <CopyCommand client:load command={install} />
    </div>
  </section>

  <section class="grid border-y border-line sm:grid-cols-3" aria-label="What Owl does">
    {
      features.map((f, i) => (
        <div class:list={['px-6 py-9 text-center', i > 0 && 'border-t border-line sm:border-t-0 sm:border-l']}>
          <p class="eyebrow">
            {String(i + 1).padStart(2, '0')} — {f.label}
          </p>
          <h2 class="mt-3 text-lg font-semibold text-ink">{f.title}</h2>
          <p class="mx-auto mt-2 max-w-xs text-[15px] leading-7 text-ink-dim">{f.text}</p>
        </div>
      ))
    }
  </section>

  <section class="mt-28 grid items-start gap-12 lg:grid-cols-[1fr_1.2fr] lg:gap-16">
    <div>
      <p class="eyebrow">A night with Owl</p>
      <h2 class="mt-4 text-3xl font-semibold tracking-tight text-ink">Queue it, leave, review in the morning.</h2>
      <p class="mt-5 text-lg leading-8 text-ink-dim">
        Register a repository, queue a prompt, and go. Owl waits for the machine to go idle, runs the agent on a
        branch of its own, checks the result, and leaves it waiting for you.
      </p>
      <a href="/docs/guide#quick-start" class="mt-6 inline-block text-[15px] text-accent no-underline hover:underline">
        Follow the quick start →
      </a>
    </div>
    <div class="min-w-0">
      <Terminal client:load />
    </div>
  </section>

  <section class="mt-28">
    <SectionHead
      eyebrow="The desktop app"
      title="See what ran, what is running, and what is waiting for you."
      subtitle="The desktop app is a view on the same daemon the CLI talks to: projects, the queue, jobs to review, and each run's log and diff."
    />
    <figure class="mt-10 overflow-hidden rounded-lg">
      <Image
        src={overview}
        alt="The Coding Owl desktop app: the overview with jobs pending, one awaiting review and one blocked."
        widths={[640, 960, 1400, 1800]}
        sizes="(min-width: 1024px) 944px, 100vw"
        class="block w-full rounded-lg"
        loading="lazy"
      />
    </figure>
  </section>

  <section class="mt-28 grid gap-10 lg:grid-cols-[16rem_1fr] lg:gap-20">
    <div class="lg:sticky lg:top-10 lg:self-start">
      <p class="eyebrow">In short</p>
      <h2 class="mt-4 text-3xl font-semibold tracking-tight text-ink">How it works, and when it fits.</h2>
      <p class="mt-5 text-ink-dim">
        The words in capitals are Owl's own; the <a href="/docs/language" class="text-accent hover:underline">language</a> page defines each one.
      </p>
      <a href={REPO} class="mt-6 inline-block text-[15px] text-accent no-underline hover:underline" rel="noopener">
        Source on GitHub →
      </a>
    </div>
    <article class="prose home-prose">
      <Content />
    </article>
  </section>
</Base>

<style>
  /* The homepage body starts with a heading; no rule above the first one. */
  .home-prose :global(h2:first-child) {
    margin-top: 0;
  }
</style>
