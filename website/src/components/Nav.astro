---
import Mark from './Mark.astro';
import { REPO } from '../lib/markdown';

const items = [
  { href: '/docs', label: 'Docs' },
  { href: '/changelog', label: 'Changelog' },
];
const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isActive = (href: string) => path === href || path.startsWith(href + '/');
---

<header class="mx-auto w-full max-w-5xl px-6 sm:px-10">
  <nav class="flex h-16 items-center gap-7" aria-label="Main">
    <a href="/" class="mr-auto flex items-center gap-2.5 text-ink no-underline">
      <Mark size={26} />
      <span class="text-[15px] font-semibold tracking-tight whitespace-nowrap">Coding Owl</span>
    </a>
    {
      items.map((item) => (
        <a
          href={item.href}
          aria-current={isActive(item.href) ? 'page' : undefined}
          class:list={[
            'text-sm no-underline transition-colors',
            isActive(item.href) ? 'text-ink' : 'text-ink-dim hover:text-ink',
          ]}
        >
          {item.label}
        </a>
      ))
    }
    <a href={REPO} class="text-sm text-ink-dim no-underline transition-colors hover:text-ink" rel="noopener">
      GitHub
      <span class="sr-only">(opens the repository)</span>
    </a>
  </nav>
</header>
