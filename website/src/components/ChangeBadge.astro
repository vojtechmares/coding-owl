---
interface Props {
  type: string;
}
const { type } = Astro.props;
const colours: Record<string, string> = {
  added: 'text-added bg-added-bg',
  changed: 'text-changed bg-changed-bg',
  deprecated: 'text-deprecated bg-deprecated-bg',
  removed: 'text-removed bg-removed-bg',
  fixed: 'text-fixed bg-fixed-bg',
  security: 'text-security bg-security-bg',
};
const colour = colours[type.toLowerCase()] ?? 'text-ink-dim bg-neutral-100';
---

<span class:list={['inline-flex items-center gap-2 rounded-(--radius-control) px-2.5 py-1 text-xs font-medium', colour]}>
  <span class="dot" aria-hidden="true"></span>
  {type}
</span>
