---
/* A section's title with a one-line subtitle and a rule beneath. */
interface Props {
  title: string;
  subtitle?: string;
  eyebrow?: string;
}
const { title, subtitle, eyebrow } = Astro.props;
---

<header class="border-b border-line pb-5">
  {eyebrow && <p class="eyebrow mb-3">{eyebrow}</p>}
  <h2 class="text-2xl font-semibold tracking-tight text-ink">{title}</h2>
  {subtitle && <p class="mt-2 text-ink-dim">{subtitle}</p>}
</header>
