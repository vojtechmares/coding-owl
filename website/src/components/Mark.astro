---
/*
 * The project logo, read from the repository (docs/assets/coding-owl-logo.png)
 * and resized at build time. The tile and its rounded corners are part of the
 * artwork.
 */
import { Image } from 'astro:assets';
import logo from '../../../docs/assets/coding-owl-logo.png';

interface Props {
  size?: number;
  class?: string;
}
const { size = 40, class: className } = Astro.props;
---

<Image
  src={logo}
  alt=""
  width={size}
  height={size}
  densities={[1, 2]}
  class:list={['shrink-0 rounded-[22%]', className]}
  loading="eager"
/>
